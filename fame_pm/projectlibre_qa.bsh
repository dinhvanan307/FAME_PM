// ProjectLibre 1.9.8. Import and save, then reopen the POD in a separate JVM.
import com.projectlibre1.exchange.*;
import com.projectlibre1.field.FieldContext;
import com.projectlibre1.pm.task.ProjectFactory;
import com.projectlibre1.pm.time.HasStartAndEnd;
import com.projectlibre1.session.CreateOptions;
import com.projectlibre1.util.Environment;
import java.io.*;
import java.util.*;

TimeZone.setDefault(TimeZone.getTimeZone("UTC"));
Environment.setStandAlone(true);
Environment.setBatchMode(true);
Environment.setVisible(false);
try {
    mode=bsh.args[0]; xml=bsh.args[1]; pod=bsh.args[2];
    factory=ProjectFactory.getInstance();
    source=new net.sf.mpxj.mspdi.MSPDIReader().read(xml);
    if ("write".equals(mode)) {
        options=new CreateOptions();
        options.setLocal(true); options.setSync(false); options.setVerify(false);
        options.setName(source.getProjectProperties().getName());
        project=factory.createProject(options);
        importer=new MicrosoftImporter();
        importer.setProjectFactory(factory); importer.setFileName(xml); importer.importProject(project);
        // ProjectLibre 1.9.8 needs a millisecond value when importing an MSPDI deadline.
        for (t : project.getTasks()) {
            s=source.getTaskByID((int)t.getId());
            t.setDeadline(s.getDeadline().getTime());
        }
        project.setName(source.getProjectProperties().getName());
        project.setFileName(pod); project.setFileType(1);
        project.recalculate();
        writer=new LocalFileImporter();
        writer.setProject(project); writer.setFileName(pod); writer.exportFile();
    } else if ("check".equals(mode)) {
        reader=new LocalFileImporter(); reader.setProjectFactory(factory); reader.setFileName(pod);
        reader.importFile(); project=reader.getProject();
        assignments=0; tasks=0; deps=0;
        for (t : project.getTasks()) {
            s=source.getTaskByID((int)t.getId());
            if (!t.getName().equals(s.getName()) || t.getStart()!=s.getStart().getTime()
                || t.getEnd()!=s.getFinish().getTime() || t.getDeadline()!=s.getDeadline().getTime())
                throw new Exception("Scheduled date, target or name differs at " + t.getName()+" "+new Date(t.getStart())+" "+new Date(t.getEnd()));
            if (t.getAssignments().size()!=1 || t.getWork(null)!=8L*3600000L)
                throw new Exception("Expected a single full QA shift at " + t.getName());
            a=t.getAssignments().iterator().next();
            expected=s.getResourceAssignments().get(0);
            if (!a.getResource().getName().equals(expected.getResource().getName()) || a.getUnits()!=1.0
                || a.getResource().getAvailabilityTable().getMaximumUnits()!=1.0)
                throw new Exception("Wrong reviewer or capacity at "+t.getName());
            actual=new TreeSet(); wanted=new TreeSet();
            for (edge : t.getPredecessorList()) actual.add(""+edge.getPredecessor().getId());
            for (edge : s.getPredecessors()) wanted.add(""+edge.getTargetTask().getID());
            if (!actual.equals(wanted)) throw new Exception("Wrong predecessors at " + t.getName());
            tasks++; assignments++; deps+=actual.size();
        }
        view=new File(xml).getName().replace(".xml","");
        days=new java.text.SimpleDateFormat("yyyy-MM-dd");
        input=new BufferedReader(new InputStreamReader(new FileInputStream(bsh.args[3]),"UTF-8"));
        input.readLine(); checked=0;
        while ((line=input.readLine())!=null) {
            cols=line.split(",");
            if (!view.equals(cols[0])) continue;
            long begin=days.parse(cols[2]).getTime(); long end=begin+86400000L;
            context=new FieldContext();
            context.setInterval(new HasStartAndEnd(){public long getStart(){return begin;} public long getEnd(){return end;}});
            name=cols[1]+" · "+cols[3]; hours=0.0;
            for (t : project.getTasks()) for (a : t.getAssignments())
                if (name.equals(a.getResource().getName())) hours+=a.getWork(context)/3600000.0;
            if (Math.abs(hours-Double.parseDouble(cols[4]))>0.001
                || Math.max(0.0,hours-8.0)!=Double.parseDouble(cols[6]))
                throw new Exception("Daily resource load differs: "+line+"; ProjectLibre="+hours);
            checked++;
        }
        input.close();
        if (tasks!=6 || assignments!=6 || checked==0) throw new Exception("Incomplete model");
        print("VERIFIED "+view+": "+tasks+" tasks; "+assignments+" assignments; "+deps+" links; "+checked+" daily loads");
    } else throw new Exception("Expected write or check");
} catch (Throwable e) { e.printStackTrace(); System.exit(1); }
System.exit(0);
